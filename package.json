{
  "name": "knex-dynamic-connection",
  "version": "5.1.1",
  "description": "Adds support for dynamically returning connection config for knex queries",
  "main": "index.js",
  "files": [
    "src",
    "index.d.ts",
    "index.js"
  ],
  "type": "commonjs",
  "scripts": {
    "pretest": "npm run lint",
    "test:mysql": "DIALECT=mysql node --enable-source-maps bin/test.js",
    "test:mysql2": "DIALECT=mysql2 node --enable-source-maps bin/test.js",
    "test:mssql": "DIALECT=mssql node --enable-source-maps bin/test.js",
    "test:pg": "DIALECT=pg node --enable-source-maps bin/test.js",
    "lint": "eslint . --ext=.ts",
    "release": "npx release-it",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/thetutlage/knex-dynamic-connection.git"
  },
  "keywords": [
    "knex",
    "db"
  ],
  "author": "virk",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thetutlage/knex-dynamic-connection/issues"
  },
  "homepage": "https://github.com/thetutlage/knex-dynamic-connection#readme",
  "devDependencies": {
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.5.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.11",
    "del-cli": "^8.0.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "mysql": "^2.18.1",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "release-it": "^21.1.3",
    "tedious": "^20.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "@testcontainers/postgresql": "^12.2.2"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "knex": "3.3.0"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": "@adonisjs/prettier-config"
}
